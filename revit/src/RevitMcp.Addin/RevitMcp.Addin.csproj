<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Copy Roslyn and other dependencies next to the add-in dll. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies only; Revit supplies the real ones at runtime. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.3.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.3.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitMcp.Core\RevitMcp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="RevitMcp.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
